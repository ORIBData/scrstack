{
  "name": "SCRS - nightly reconcile",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "8c3f2e86-3f40-4e5d-9c23-000000000001",
      "name": "Every night at 02:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SCRS_BASE_URL }}/scrs/v1/maintenance/rescan",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "8c3f2e86-3f40-4e5d-9c23-000000000002",
      "name": "Rescan default branches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "notes": "Header Auth credential: Authorization = Bearer <SCRS admin token>. Queues only repositories not assessed recently."
    }
  ],
  "connections": {
    "Every night at 02:00": {
      "main": [
        [
          {
            "node": "Rescan default branches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
