{
  "name": "SCRS - assessment completed",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scrs-events",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "7b2e1d75-2e3f-4d4c-8b12-000000000001",
      "name": "SCRS events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "7b2e1d75-2e3f-4d4c-8b12-0000000000a1",
      "notes": "Header Auth credential: Name = X-SCRS-Auth, Value = auth_header.value returned when the SCRS subscription was created or its secret rotated. No Code node or NODE_FUNCTION_ALLOW_BUILTIN needed."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.event.type }}",
              "rightValue": "assessment.completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7b2e1d75-2e3f-4d4c-8b12-000000000002",
      "name": "Assessment completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.body.data.assessment.verdict }}",
              "rightValue": "fail",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7b2e1d75-2e3f-4d4c-8b12-000000000003",
      "name": "Verdict is fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $json.body.data.assessment.repository }}/statuses/{{ $json.body.data.assessment.commit }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ state: 'failure', context: 'scrs/supply-chain', description: 'SCRS verdict: ' + $json.body.data.assessment.verdict, target_url: $json.body.data.links.report }) }}",
        "options": {}
      },
      "id": "7b2e1d75-2e3f-4d4c-8b12-000000000004",
      "name": "Set failing commit status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -160
      ],
      "notes": "Uses n8n's own GitHub credential (statuses:write). SCRS never writes to GitHub."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $json.body.data.assessment.repository }}/statuses/{{ $json.body.data.assessment.commit }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ state: $json.body.data.assessment.verdict === 'incomplete' ? 'pending' : 'success', context: 'scrs/supply-chain', description: 'SCRS verdict: ' + $json.body.data.assessment.verdict, target_url: $json.body.data.links.report }) }}",
        "options": {}
      },
      "id": "7b2e1d75-2e3f-4d4c-8b12-000000000005",
      "name": "Set neutral or passing status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        40
      ],
      "notes": "incomplete is reported as pending: partial coverage is never a pass."
    }
  ],
  "connections": {
    "SCRS events": {
      "main": [
        [
          {
            "node": "Assessment completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assessment completed?": {
      "main": [
        [
          {
            "node": "Verdict is fail?",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Verdict is fail?": {
      "main": [
        [
          {
            "node": "Set failing commit status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set neutral or passing status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
