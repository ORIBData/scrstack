# Copy to .env for local Compose, or paste these values into Dokploy's Compose
# environment. Never commit the populated .env file.

# SCRS image repository and automatic release tag (UTC date + 12 SHA-256 source characters).
# Build locally: make image
# Build and push: make release PLATFORMS=linux/amd64,linux/arm64
# AMD64 only: make release PLATFORMS=linux/amd64
# Print the concrete image reference: make image-reference
# Use that concrete reference for SCRS_IMAGE in Dokploy; Compose cannot expand this template.
SCRS_IMAGE=oribdata/zerorate-stg:scrs_YYYY_MM_DD_v{shortSHA256}
# To switch to GAR, replace the active SCRS_IMAGE above with your full GAR path:
# SCRS_IMAGE=europe-west2-docker.pkg.dev/YOUR_PROJECT/YOUR_REPOSITORY/scrs:scrs_YYYY_MM_DD_v{shortSHA256}
# Docker Hub release prompts for username/PAT; GAR prompts for an access token.

# PostgreSQL: the app URL names the SCRS database and application role.
# Percent-encode special characters in URL passwords. Use sslmode=require when
# the PostgreSQL service supports TLS; use verify-full with a trusted CA for
# remote production hosts. The role needs CONNECT and CREATE on its database.
SCRS_DATABASE_URL=postgres://scrs_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres.example.net:5432/scrs?sslmode=verify-full
SCRS_DATABASE_SCHEMA=scrs

# Optional bootstrap-only admin URL. Set it if the `scrs` database does not
# exist. Its role needs CREATEDB and the scrs_app role must already exist.
# Keep this credential out of the long-running API after the first deployment.
SCRS_DATABASE_ADMIN_URL=

# Redis or Dragonfly. Queue URL must permit PING, XADD, XRANGE, EXPIRE and DEL.
# Cache URL falls back to the queue URL; it must permit SET, GET and DEL.
SCRS_REDIS_QUEUE_URL=rediss://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis.example.net:6379/0
SCRS_REDIS_CACHE_URL=

# S3-compatible object storage. The endpoint is an origin, not a bucket URL.
# Credentials need bucket lookup and object Put/Get/Delete (including version
# deletion when versioning is enabled). If the bucket is
# missing, bootstrap also needs CreateBucket. Use path style for MinIO and many
# other S3-compatible providers; set false only when your provider needs it.
SCRS_S3_ENDPOINT=https://s3.example.net
SCRS_S3_REGION=us-east-1
SCRS_S3_BUCKET=scrs-artifacts
SCRS_S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
SCRS_S3_SECRET_KEY=REPLACE_WITH_SECRET_KEY
SCRS_S3_FORCE_PATH_STYLE=true

# Required to encrypt REST-managed connection credentials. Generate the key once with
# `openssl rand -base64 32`; keep the same value across redeployments.
SCRS_MASTER_KEY=BASE64_32_BYTE_KEY
# Admin token for the connection REST API. Generate at least 32 random bytes,
# for example: openssl rand -hex 32. Keep it on the server/BFF, not in a browser.
SCRS_BOOTSTRAP_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# GitHub, Docker Hub and GAR connections are created after deployment through
# POST /scrs/v1/connections. Their credentials are not build or Compose inputs.
# See docs/PROVIDERS.md for request examples and provider approval rules.


# Dokploy routing: hostname only; use a unique router name per environment.
SCRS_DOMAIN=scrs.example.com
SCRS_ROUTER_NAME=scrs-staging
SCRS_TRAEFIK_NETWORK=dokploy-network
SCRS_HTTP_ENTRYPOINT=web
SCRS_HTTPS_ENTRYPOINT=websecure
SCRS_CERT_RESOLVER=letsencrypt
# Public Swagger UI/OpenAPI; management endpoints still require tokens.
SCRS_DOCS_PUBLIC=true
# Comma-separated exact browser origins; empty disables cross-origin access.
SCRS_CORS_ORIGINS=

# Only exact trusted Traefik peer CIDRs. Empty ignores forwarded IP headers.
# Required for client IP token restrictions behind Traefik; never use 0.0.0.0/0.
SCRS_TRUSTED_PROXY_CIDRS=

# Internal isolated scanner token; never a provider or API token.
SCRS_SCANNER_API_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_32_PLUS_CHARACTER_TOKEN
# OSV ecosystem archives mirrored locally for offline scanning. Alpine and
# Debian cover container image OS packages. Ubuntu's archive (~815 MB) exceeds
# the 512 MiB per-feed cap and is not supported.
SCRS_OSV_ECOSYSTEMS=npm,Go,Maven,PyPI,Pub,SwiftURL,RubyGems,Alpine,Debian

# Guided remediation is active; plans are advice only and never write to repositories.
SCRS_REMEDIATION_ENABLED=true

# Set in deployment to the external HTTPS origin served by Dokploy Traefik.
SCRS_PUBLIC_BASE_URL=
# Optional read-scoped token; acceptance falls back to bootstrap token.
SCRS_ACCEPTANCE_API_TOKEN=


# GitHub never retries a failed webhook delivery. The worker reads SCRS's webhook
# delivery log on this interval and requests redelivery of missed events; 0 disables.
SCRS_GITHUB_HOOK_CHECK_MINUTES=5

# Private ClamAV INSTREAM endpoint; no public port.
SCRS_CLAMD_ADDRESS=scrs-clamav:3310
# Operator-controlled versioned JSON indicator bundle inside scanner container.
SCRS_INDICATOR_FILE=

# Official ClamAV image supports native AMD64 and ARM64.
SCRS_CLAMAV_IMAGE=clamav/clamav:1.5.4-debian13-slim@sha256:76a9c3b63764b78178dc68fa7efcceca0cde2c8c9d4f925a8e697cb4511f8fdc

# Used only with the optional compose.nodeport.yaml localhost diagnostic override.
SCRS_HTTP_NODE_PORT=7000

# Includes headroom for signature reloads; this is a limit, not a reservation.
SCRS_CLAMAV_MEMORY=4g

# --- Outbound webhooks and relay (2026-11-13) ---------------------------------
# Accept n8n relay deliveries on POST /scrs/v1/ingest/github with an
# ingest:relay token. Direct GitHub HMAC delivery works regardless.
SCRS_RELAY_ENABLED=false
# Hostnames allowed for http:// or private-address webhook targets, e.g. an
# n8n container on the same Docker network. Everything else must be public https.
SCRS_WEBHOOK_PRIVATE_HOSTS=
# TAXII 2.1 feeds: how often the worker checks for due feeds (0 disables), and
# feed hostnames allowed to resolve to private addresses (an internal OpenCTI).
SCRS_TAXII_POLL_SECONDS=60
SCRS_TAXII_PRIVATE_HOSTS=
# NVD and CVE Program records for CVEs the register references: how often the worker
# checks for due sources (0 disables). An NVD API key raises the rate limit
# (https://nvd.nist.gov/developers/request-an-api-key).
SCRS_ADVISORY_SYNC_SECONDS=60
SCRS_NVD_API_KEY=
# Retention defaults per data class, used when the policy leaves a class "not set"
# (0 or empty = keep forever; audit_log is never below 365). Classes: INBOUND_EVENTS,
# WEBHOOK_DELIVERIES, CLOSED_FINDINGS, SCAN_ARTIFACTS, SBOM_DOCUMENTS, SOURCE_SNAPSHOTS,
# REMEDIATION_PLANS, QA_REPORTS, REPORTS, EXPIRED_INDICATORS, AUDIT_LOG.
SCRS_RETENTION_DEFAULT_CLOSED_FINDINGS_DAYS=
SCRS_RETENTION_DEFAULT_AUDIT_LOG_DAYS=
# Optional https JSON release feed (tag_name or version) for GET /maintenance/versions,
# for example https://api.github.com/repos/<owner>/<repo>/releases/latest
SCRS_RELEASE_FEED_URL=
# Licences and safe versions (M8): the worker reads licence metadata and version lists
# from deps.dev for packages without a declared or detected licence, cached in PostgreSQL
# (30 days per version). false evaluates those packages as "no licence found". The URL
# and private hosts serve a mirror; MAX_LOOKUPS bounds licence lookups per assessment.
SCRS_DEPSDEV_ENABLED=true
SCRS_DEPSDEV_URL=
SCRS_DEPSDEV_PRIVATE_HOSTS=
SCRS_DEPSDEV_MAX_LOOKUPS=2000
# Compliance evidence reports: how often the worker builds queued reports (0 disables).
SCRS_REPORT_POLL_SECONDS=30
# SAST analyzers and Go reachability (M9). The Dokploy stack runs scrs-sast from its
# own image (make release-sast) on the internal sast network; Go module downloads go
# through scrs-sast-egress (proxy.golang.org, sum.golang.org only). Both are off by
# default: enable here for every asset, or per asset with PUT /assets/{id}/sast.
SCRS_SAST_IMAGE=REPLACE_WITH_PUBLISHED_SCRS_SAST_IMAGE
SCRS_SAST_API_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
SCRS_SAST_ENABLED=false
SCRS_REACHABILITY_ENABLED=false
# Analyzers allowed to run; Bearer (Elastic License 2.0) and the OpenGrep rules
# (LGPL-2.1 with Commons Clause) are for internal use only.
SCRS_SAST_ANALYZERS=gosec,bandit,opengrep,bearer
# Per-analyzer budget (a breach makes the assessment incomplete) and score changes for
# reachable and not-reachable vulnerabilities.
SCRS_SAST_TIMEOUT=10m
SCRS_REACHABILITY_WEIGHTS=10,-15
SCRS_SAST_MEMORY=4g
SCRS_SAST_WORK_SIZE=4g
# E2E QA (Karate). The Dokploy stack deploys the runner as scrs-qa-runner from its
# own image (make release-qa-runner); SCRS reaches it on the private qa network.
SCRS_QA_RUNNER_IMAGE=registry.example.com/team/scrs-qa-runner:scrs_YYYY_MM_DD_v{shortSHA256}
# One token shared by SCRS and the runner (32+ random characters: openssl rand -hex 32).
SCRS_QA_RUNNER_TOKEN=
# The runner's public hostname behind Traefik, and who may call it there (comma-
# separated CIDRs). SCRS itself uses the private URL, so the default allows nobody.
SCRS_QA_DOMAIN=qa-runner.example.com
SCRS_QA_ROUTER_NAME=scrs-qa
SCRS_QA_RUNNER_ALLOWED_CIDRS=127.0.0.1/32
SCRS_QA_RUNNER_SLOTS=1
SCRS_QA_RUNNER_MEMORY=3g
# tmpfs for job files (sources, reports, browser profiles).
SCRS_QA_RUNNER_WORK_SIZE=2g
# Private stack URL by default; set https://... for a runner on another host
# (with SCRS_QA_RUNNER_ALLOW_HTTP=false).
SCRS_QA_RUNNER_URL=http://scrs-qa-runner:8090
SCRS_QA_RUNNER_ALLOW_HTTP=true
# PEM file trusted for the runner's certificate when it is privately issued.
SCRS_QA_RUNNER_CA_FILE=
# Runs on the runner at once (submitted or running).
SCRS_QA_MAX_ACTIVE=4
# LLM test generation (providers are added with POST /llm/providers).
SCRS_QA_GENERATION_ENABLED=true
# Self-hosted model hosts (Ollama, vLLM) allowed to resolve to private addresses
# and to use plain http.
SCRS_LLM_PRIVATE_HOSTS=
# A push removing at least this many files raises a mass-deletion alert (INT-002).
SCRS_MASS_DELETION_FILES=50
# full/agent payload limits and JSON Pointer redactions ("*" = any array index).
SCRS_EVENT_MAX_BYTES=1048576
SCRS_EVENT_FIELD_MAX=512
SCRS_EVENT_REDACT=

# --- Images, snapshots, scheduling (2026-11-13) -------------------------------
# Image assessments scan OS packages (Alpine/Debian feeds) and every layer file
# with ClamAV, YARA and IOC rules. An image whose OS feed is missing reports
# inventory failed and verdict incomplete.
SCRS_MAX_IMAGE_BYTES=419430400
SCRS_SCANNER_MEMORY=3g
# Store each fetched source archive in S3 for incident restore (admin download).
SCRS_SNAPSHOT_ARCHIVES=false
# Rescan every in-scope repository's default branch at this interval; 0 = off.
SCRS_RESCAN_INTERVAL_HOURS=0
# Git history mirrors: POST /assets/{id}/mirrors on demand; with an interval,
# assets labelled mirror=true are mirrored automatically. Bundles restore with
# `git clone <file>.bundle`. A bundle is pruned only when it is beyond the newest
# SCRS_MIRROR_KEEP AND older than SCRS_MIRROR_MIN_AGE_DAYS; the newest bundle taken
# before an open integrity finding on the asset is never pruned.
SCRS_MIRRORS_ENABLED=true
SCRS_MIRROR_INTERVAL_HOURS=0
SCRS_MIRROR_MAX_BYTES=2147483648
SCRS_MIRROR_KEEP=7
SCRS_MIRROR_MIN_AGE_DAYS=30
