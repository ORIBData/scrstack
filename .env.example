# Copy to .env for local Compose, or paste these values into Dokploy's Compose
# environment. Never commit the populated .env file.

# SCRS image repository and automatic release tag (UTC date + 12 SHA-256 source characters).
# Build locally: make image
# Build and push: make release PLATFORMS=linux/amd64,linux/arm64
# AMD64 only: make release PLATFORMS=linux/amd64
# Print the concrete image reference: make image-reference
# Use that concrete reference for SCRS_IMAGE in Dokploy; Compose cannot expand this template.
SCRS_IMAGE=oribdata/zerorate-stg:scrs_YYYY_MM_DD_v{shortSHA256}
# To switch to GAR, replace the active SCRS_IMAGE above with your full GAR path:
# SCRS_IMAGE=europe-west2-docker.pkg.dev/YOUR_PROJECT/YOUR_REPOSITORY/scrs:scrs_YYYY_MM_DD_v{shortSHA256}
# Docker Hub release prompts for username/PAT; GAR prompts for an access token.

# PostgreSQL: the app URL names the SCRS database and application role.
# Percent-encode special characters in URL passwords. Use sslmode=require when
# the PostgreSQL service supports TLS; use verify-full with a trusted CA for
# remote production hosts. The role needs CONNECT and CREATE on its database.
SCRS_DATABASE_URL=postgres://scrs_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres.example.net:5432/scrs?sslmode=verify-full
SCRS_DATABASE_SCHEMA=scrs

# Optional bootstrap-only admin URL. Set it if the `scrs` database does not
# exist. Its role needs CREATEDB and the scrs_app role must already exist.
# Keep this credential out of the long-running API after the first deployment.
SCRS_DATABASE_ADMIN_URL=

# Redis or Dragonfly. Queue URL must permit PING, XADD, XRANGE, EXPIRE and DEL.
# Cache URL falls back to the queue URL; it must permit SET, GET and DEL.
SCRS_REDIS_QUEUE_URL=rediss://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis.example.net:6379/0
SCRS_REDIS_CACHE_URL=

# S3-compatible object storage. The endpoint is an origin, not a bucket URL.
# Credentials need bucket lookup and object Put/Get/Delete (including version
# deletion when versioning is enabled). If the bucket is
# missing, bootstrap also needs CreateBucket. Use path style for MinIO and many
# other S3-compatible providers; set false only when your provider needs it.
SCRS_S3_ENDPOINT=https://s3.example.net
SCRS_S3_REGION=us-east-1
SCRS_S3_BUCKET=scrs-artifacts
SCRS_S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
SCRS_S3_SECRET_KEY=REPLACE_WITH_SECRET_KEY
SCRS_S3_FORCE_PATH_STYLE=true

# Required to encrypt REST-managed connection credentials. Generate the key once with
# `openssl rand -base64 32`; keep the same value across redeployments.
SCRS_MASTER_KEY=BASE64_32_BYTE_KEY
# Admin token for the connection REST API. Generate at least 32 random bytes,
# for example: openssl rand -hex 32. Keep it on the server/BFF, not in a browser.
SCRS_BOOTSTRAP_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# GitHub, Docker Hub and GAR connections are created after deployment through
# POST /scrs/v1/connections. Their credentials are not build or Compose inputs.
# See docs/PROVIDERS.md for request examples and provider approval rules.


# Dokploy routing: hostname only; use a unique router name per environment.
SCRS_DOMAIN=scrs.example.com
SCRS_ROUTER_NAME=scrs-staging
SCRS_TRAEFIK_NETWORK=dokploy-network
SCRS_HTTP_ENTRYPOINT=web
SCRS_HTTPS_ENTRYPOINT=websecure
SCRS_CERT_RESOLVER=letsencrypt
# Public Swagger UI/OpenAPI; management endpoints still require tokens.
SCRS_DOCS_PUBLIC=true
# Comma-separated exact browser origins; empty disables cross-origin access.
SCRS_CORS_ORIGINS=

# Only exact trusted Traefik peer CIDRs. Empty ignores forwarded IP headers.
# Required for client IP token restrictions behind Traefik; never use 0.0.0.0/0.
SCRS_TRUSTED_PROXY_CIDRS=

# Internal isolated scanner token; never a provider or API token.
SCRS_SCANNER_API_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_32_PLUS_CHARACTER_TOKEN
# OSV ecosystem archives mirrored locally for offline scanning.
SCRS_OSV_ECOSYSTEMS=npm,Go

# Guided remediation is active; plans are advice only and never write to repositories.
SCRS_REMEDIATION_ENABLED=true

# Set in deployment to the external HTTPS origin served by Dokploy Traefik.
SCRS_PUBLIC_BASE_URL=
# Optional read-scoped token; acceptance falls back to bootstrap token.
SCRS_ACCEPTANCE_API_TOKEN=

# Optional direct GitHub push ingestion; set the same random 32+ character secret in GitHub.
SCRS_GITHUB_WEBHOOK_SECRET=
# Private ClamAV INSTREAM endpoint; no public port.
SCRS_CLAMD_ADDRESS=scrs-clamav:3310
# Operator-controlled versioned JSON indicator bundle inside scanner container.
SCRS_INDICATOR_FILE=

# Official ClamAV image supports native AMD64 and ARM64.
SCRS_CLAMAV_IMAGE=clamav/clamav:1.5.4-debian13-slim@sha256:76a9c3b63764b78178dc68fa7efcceca0cde2c8c9d4f925a8e697cb4511f8fdc

# Used only with the optional compose.nodeport.yaml localhost diagnostic override.
SCRS_HTTP_NODE_PORT=8080

# Includes headroom for signature reloads; this is a limit, not a reservation.
SCRS_CLAMAV_MEMORY=4g
