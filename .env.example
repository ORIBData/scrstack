# Copy to .env for local Compose, or paste these values into Dokploy's Compose
# environment. Never commit the populated .env file.

# Example release: make release DOCKERHUB_REPO=oribdata/zerorate-stg VERSION=scrs_v<short-sha>
# Replace the braces in the tag below with the actual short commit SHA.
SCRS_IMAGE=oribdata/zerorate-stg:scrs_v{shortSHA256}

# PostgreSQL: the app URL names the SCRS database and application role.
# Percent-encode special characters in URL passwords. Use sslmode=require when
# the PostgreSQL service supports TLS; use verify-full with a trusted CA for
# remote production hosts. The role needs CONNECT and CREATE on its database.
SCRS_DATABASE_URL=postgres://scrs_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres.example.net:5432/scrs?sslmode=verify-full
SCRS_DATABASE_SCHEMA=scrs

# Optional bootstrap-only admin URL. Set it if the `scrs` database does not
# exist. Its role needs CREATEDB and the scrs_app role must already exist.
# Keep this credential out of the long-running API after the first deployment.
SCRS_DATABASE_ADMIN_URL=

# Redis or Dragonfly. Queue URL must permit PING, XADD, XRANGE, EXPIRE and DEL.
# Cache URL falls back to the queue URL; it must permit SET, GET and DEL.
SCRS_REDIS_QUEUE_URL=rediss://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis.example.net:6379/0
SCRS_REDIS_CACHE_URL=

# S3-compatible object storage. The endpoint is an origin, not a bucket URL.
# Credentials need bucket lookup and object Put/Get/Delete (including version
# deletion when versioning is enabled). If the bucket is
# missing, bootstrap also needs CreateBucket. Use path style for MinIO and many
# other S3-compatible providers; set false only when your provider needs it.
SCRS_S3_ENDPOINT=https://s3.example.net
SCRS_S3_REGION=us-east-1
SCRS_S3_BUCKET=scrs-artifacts
SCRS_S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
SCRS_S3_SECRET_KEY=REPLACE_WITH_SECRET_KEY
SCRS_S3_FORCE_PATH_STYLE=true

# Required to encrypt REST-managed connection credentials. Generate the key once with
# `openssl rand -base64 32`; keep the same value across redeployments.
SCRS_MASTER_KEY=BASE64_32_BYTE_KEY
# Admin token for the connection REST API. Generate at least 32 random bytes,
# for example: openssl rand -hex 32. Keep it on the server/BFF, not in a browser.
SCRS_BOOTSTRAP_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# GitHub, Docker Hub and GAR connections are created after deployment through
# POST /scrs/v1/connections. Their credentials are not build or Compose inputs.
# See docs/PROVIDERS.md for request examples and provider approval rules.
