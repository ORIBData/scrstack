{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrs.local/schemas/framework-pack/1",
  "title": "SCRS framework pack (CWE mapping or STIG)",
  "description": "A custom compliance framework pack (CMP-005): categories, each a set of CWE ids. Findings are counted in every category whose CWEs they carry; finding types without a CWE can be mapped with type_categories. A stig pack (CMP-004) is created by importing a DISA XCCDF benchmark; download it, edit the CWE and type mapping, and upload it here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "categories"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$",
      "description": "Unique pack id; shipped pack ids are reserved"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "cwe_mapping",
        "stig"
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 500
    },
    "url": {
      "type": "string",
      "maxLength": 500
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "cwes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "cwes": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            }
          },
          "severity": {
            "enum": [
              "CAT I",
              "CAT II",
              "CAT III"
            ],
            "description": "stig only"
          },
          "vuln_id": {
            "type": "string",
            "maxLength": 64,
            "description": "stig only: DISA vulnerability id (V-...)"
          },
          "rule_id": {
            "type": "string",
            "maxLength": 128,
            "description": "stig only: XCCDF rule id (SV-...)"
          },
          "ccis": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 32
            },
            "description": "stig only: CCI identifiers"
          }
        }
      },
      "description": "At most 200 for cwe_mapping, 2000 for stig"
    },
    "type_categories": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Finding type (vulnerability, malicious_dependency, integrity, secret, misconfiguration, code) to category id"
    },
    "type_categories_note": {
      "type": "string",
      "maxLength": 1000
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "description": "stig only: the imported benchmark",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "release": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "builtin": {
      "const": false,
      "description": "Present in packs read from the API; uploads cannot set it"
    }
  }
}
