{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrs.local/schemas/framework-pack/1",
  "title": "SCRS framework pack (CWE mapping)",
  "description": "A custom compliance framework pack (CMP-005): categories, each a set of CWE ids. Findings are counted in every category whose CWEs they carry; finding types without a CWE can be mapped with type_categories.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "kind", "categories"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$", "description": "Unique pack id; shipped pack ids are reserved"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "kind": {"const": "cwe_mapping"},
    "source": {"type": "string", "maxLength": 500},
    "url": {"type": "string", "maxLength": 500},
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "cwes"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "cwes": {"type": "array", "maxItems": 2000, "items": {"type": "integer", "minimum": 1, "maximum": 99999}}
        }
      }
    },
    "type_categories": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Finding type (vulnerability, malicious_dependency, integrity, secret, misconfiguration, code) to category id"},
    "type_categories_note": {"type": "string", "maxLength": 1000}
  }
}
